rules_version = '2';

// SOLO PARA EL EMULADOR / DESARROLLO LOCAL.
// Reglas permisivas para no bloquear el trabajo de interfaces mientras la regla de
// lectura del analista (F1) no exista. NO representan el perímetro real: las reglas de
// producción se definen aparte. Nunca desplegar esto a un proyecto real.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
