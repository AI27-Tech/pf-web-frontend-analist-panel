# Configuración del SDK web de Firebase, del proyecto custodio-906e7268.
#
# Estos valores NO son secretos: identifican el proyecto, no autorizan nada. Lo que
# protege los datos son las reglas de Firestore y Storage (ver docs/PLAN.md §2 y §6).
# Se toman de la consola de Firebase, en la app web registrada para este panel.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=custodio-906e7268.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=custodio-906e7268
VITE_FIREBASE_STORAGE_BUCKET=custodio-906e7268.firebasestorage.app
VITE_FIREBASE_APP_ID=

# Apunta el SDK al Emulator Suite en lugar de al proyecto real. Útil mientras la
# regla de lectura del analista no exista (docs/PLAN.md §6).
VITE_USAR_EMULADORES=false
