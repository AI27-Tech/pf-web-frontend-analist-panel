# Configuración del SDK web de Firebase, del proyecto custodio-906e7268.
#
# Estos valores NO son secretos: identifican el proyecto, no autorizan nada. Lo que
# protege los datos son las reglas de Firestore y Storage (ver docs/PLAN.md §2 y §6).
#
# `apiKey` y `appId` salen de la consola de Firebase, en la app WEB registrada para
# este panel (Project settings → Your apps → Web app).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=custodio-906e7268.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=custodio-906e7268
VITE_FIREBASE_STORAGE_BUCKET=custodio-906e7268.firebasestorage.app
VITE_FIREBASE_APP_ID=

# Apunta el SDK al Emulator Suite en lugar de al proyecto real. Útil para trabajar
# contra datos sembrados sin tocar producción.
VITE_USAR_EMULADORES=false

# SOLO DESARROLLO: sirve la lista de viajes desde el arreglo estático en lugar de
# Firestore. La lectura real del analista se autoriza por su CORREO en
# `config/analistas.correos`; con el correo dado de alta y este flag en false,
# el panel lee datos reales.
VITE_DATOS_MOCK=false
