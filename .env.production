# Configuración del SDK web de Firebase para el build de producción.
#
# Vite carga este archivo automáticamente en `vite build` (modo production), así
# que el build de CI/CD (GitHub Actions → Firebase Hosting) toma estos valores sin
# depender del `.env` local, que es por máquina y no se versiona.
#
# Estos valores NO son secretos: identifican el proyecto, no autorizan nada, y de
# hecho viajan en el bundle del cliente en cualquier app web de Firebase. Lo que
# protege los datos son las reglas de Firestore y Storage (ver docs/PLAN.md §2 y §6).
# Lo que NUNCA se versiona es la cuenta de servicio; eso vive en secretos.
VITE_FIREBASE_API_KEY=AIzaSyB3XtUP63-zJN7Yjh7g-RSFuX83KqoljXE
VITE_FIREBASE_AUTH_DOMAIN=custodio-906e7268.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=custodio-906e7268
VITE_FIREBASE_STORAGE_BUCKET=custodio-906e7268.firebasestorage.app
VITE_FIREBASE_APP_ID=1:755381066416:web:e167fd1645de8ed3fdb975

# Producción apunta al proyecto real, no a los emuladores.
VITE_USAR_EMULADORES=false

# Lee datos reales de Firestore (autorizados por el correo del analista), no el mock.
VITE_DATOS_MOCK=false
