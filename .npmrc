# Acceso a @ai27-tech/ui (GitHub Packages, no está en el registro público).
#
# Este archivo NO contiene el token: lo lee de la variable de entorno
# GH_PACKAGES_TOKEN. Por eso es seguro versionarlo.
#   - En local:  export GH_PACKAGES_TOKEN=tu_token_con_read:packages
#   - En CI:      lo inyecta el workflow desde secrets.GH_PACKAGES_TOKEN
#   - En la nube: Firebase App Hosting lo inyecta desde Secret Manager
#                 (ver apphosting.yaml y firebase apphosting:secrets:set)
@ai27-tech:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${GH_PACKAGES_TOKEN}
# always-auth fuerza a enviar el token en TODAS las peticiones al host, incluida
# la descarga del tarball (npm.pkg.github.com/download/...), que redirige y de lo
# contrario viaja sin credenciales → 401. Necesario con pnpm y GitHub Packages.
//npm.pkg.github.com/:always-auth=true
always-auth=true
